# OpenAI (Chatbot Assistant)
OPENAI_API_KEY="your-openai-api-key"

# Supabase Storage (Resume File Uploads)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Resend Email Service (Careers Application Notifications)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY="re_123456789_your_resend_api_key"

# Verified sender address in Resend (e.g., careers@yourdomain.com or onboarding@resend.dev for testing)
RESEND_FROM_EMAIL="Hotel Prabhupada Careers <careers@hotelprabhupada.com>"

# Notification recipient for job applications (e.g. Hotel General Manager / HR Desk)
GM_NOTIFICATION_EMAIL="gm@hotelprabhupada.com"
